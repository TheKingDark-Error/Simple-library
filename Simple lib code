                    New("Frame", {
                        Name = "Indicator",
                        Size = UDim2.new(0, 16, 0, 16),
                        Position = UDim2.new(0, 3, 0, 3),
                        BackgroundColor3 = Color3.fromRGB(200, 200, 210),
                        BorderSizePixel = 0,
                    }, { New("UICorner", { CornerRadius = UDim.new(1, 0) }) }),
                }),
            })
            RegisterThemeObject(ToggleFrame, "BackgroundColor3", "Element")
            RegisterThemeObject(ToggleFrame.Title, "TextColor3", "TextPrimary")
            RegisterThemeObject(ToggleFrame.Desc, "TextColor3", "TextSecondary")

            local ToggleBtn = ToggleFrame.ToggleBtn
            local Indicator = ToggleBtn.Indicator

            local function UpdateVisual(animate)
                animate = animate ~= false
                if IsToggled then
                    if animate then
                        Tween(ToggleBtn, { BackgroundColor3 = GetTheme().ToggleOn }, 0.25)
                        Tween(Indicator, { Position = UDim2.new(0, 29, 0, 3) }, 0.25, Enum.EasingStyle.Back)
                        Tween(Indicator, { BackgroundColor3 = Color3.fromRGB(255, 255, 255) }, 0.2)
                    else
                        ToggleBtn.BackgroundColor3 = GetTheme().ToggleOn
                        Indicator.Position = UDim2.new(0, 29, 0, 3)
                        Indicator.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                    end
                else
                    if animate then
                        Tween(ToggleBtn, { BackgroundColor3 = GetTheme().ToggleOff }, 0.25)
                        Tween(Indicator, { Position = UDim2.new(0, 3, 0, 3) }, 0.25, Enum.EasingStyle.Back)
                        Tween(Indicator, { BackgroundColor3 = Color3.fromRGB(200, 200, 210) }, 0.2)
                    else
                        ToggleBtn.BackgroundColor3 = GetTheme().ToggleOff
                        Indicator.Position = UDim2.new(0, 3, 0, 3)
                        Indicator.BackgroundColor3 = Color3.fromRGB(200, 200, 210)
                    end
                end
            end
            UpdateVisual(false)

            ToggleBtn.MouseButton1Click:Connect(function()
                IsToggled = not IsToggled
                UpdateVisual(true)
                callback(IsToggled)
            end)

            ToggleBtn.MouseEnter:Connect(function()
                if IsToggled then
                    Tween(ToggleBtn, { BackgroundColor3 = GetTheme().ToggleHoverOn }, 0.15)
                else
                    Tween(ToggleBtn, { BackgroundColor3 = GetTheme().ToggleHoverOff }, 0.15)
                end
            end)
            ToggleBtn.MouseLeave:Connect(function()
                if IsToggled then
                    Tween(ToggleBtn, { BackgroundColor3 = GetTheme().ToggleOn }, 0.15)
                else
                    Tween(ToggleBtn, { BackgroundColor3 = GetTheme().ToggleOff }, 0.15)
                end
            end)

            ToggleFrame.Parent = Tab.Content

            table.insert(Tab.Elements, {
                Frame = ToggleFrame,
                Searchable = true,
                SearchText = togTitle .. " " .. togDesc,
            })

            return {
                Set = function(val)
                    IsToggled = val
                    UpdateVisual(true)
                    callback(IsToggled)
                end,
                Get = function() return IsToggled end,
            }
        end
