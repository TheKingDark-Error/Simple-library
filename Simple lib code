    local function FilterTabs(query)
        query = string.lower(query or "")
        for i, tabData in ipairs(Window.Tabs) do
            local btn = Window.TabButtons[i]
            if btn then
                local tabTitle = string.lower(tabData.Title or "")
                if query == "" or string.find(tabTitle, query, 1, true) then
