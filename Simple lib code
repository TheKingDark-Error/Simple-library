            local IsToggled = togConfig.state
            if IsToggled == nil then IsToggled = togConfig.Enable == true end
            if IsToggled == nil then IsToggled = false end

            local ToggleFrame = New("Frame", {
                Size = UDim2.new(1, 0, 0, 52),
