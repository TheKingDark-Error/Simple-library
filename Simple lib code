            BindBtn.MouseButton1Click:Connect(function()
                if Listening then return end
                Listening = true
                BindBtn.Text = "..."
                local conn
                conn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
                    if gameProcessed then return end
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        CurrentKey = input.KeyCode
                        BindBtn.Text = CurrentKey.Name
                        Listening = false
                        if conn then conn:Disconnect() end
                        if configKey then
                            Window:_saveElement(configKey, CurrentKey.Name)
                        end
                        callback(CurrentKey)
                    end
                end)
            end)

            -- Global listener for bind activation
            local bindConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
                if gameProcessed then return end
                if input.KeyCode == CurrentKey and not Listening then
                    callback(CurrentKey)
                end
            end)

            BindBtn.MouseEnter:Connect(function()
                BindBtn.BackgroundColor3 = theme.buttonHover
            end)
            BindBtn.MouseLeave:Connect(function()
                BindBtn.BackgroundColor3 = theme.button
            end)

            AttachTooltip(BindFrame, tooltipText)
            BindFrame.Parent = Tab.Content
            return {
                ElementFrame = BindFrame,
                GetValue = function() return CurrentKey end,
                SetValue = function(_, key)
                    CurrentKey = key
                    BindBtn.Text = CurrentKey.Name
                    if configKey then
                        Window:_saveElement(configKey, CurrentKey.Name)
                    end
                    callback(CurrentKey)
                end,
                _connection = bindConn
            }
        end

