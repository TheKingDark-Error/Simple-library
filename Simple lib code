                }),
                New("TextLabel", {
                    Name = "Desc",
                    Text = desc,
                    TextColor3 = Color3.fromRGB(160, 160, 180),
                    Font = Enum.Font.Gotham,
                    TextSize = 11,
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 12, 0, 22),
                    Size = UDim2.new(1, -24, 0, 14),
                    ZIndex = 11
                }),
                New("TextLabel", {
                    Name = "ValueLabel",
                    Text = tostring(CurrentValue),
                    TextColor3 = Color3.fromRGB(220, 220, 235),
                    Font = Enum.Font.GothamBold,
                    TextSize = 13,
                    BackgroundTransparency = 1,
                    Position = UDim2.new(1, -50, 0, 6),
                    Size = UDim2.new(0, 40, 0, 16),
                    TextXAlignment = Enum.TextXAlignment.Right,
                    ZIndex = 11
                }),
                New("Frame", {
                    Name = "Track",
                    Size = UDim2.new(1, -24, 0, 6),
                    Position = UDim2.new(0, 12, 0, 40),
                    BackgroundColor3 = Color3.fromRGB(45, 45, 58),
                    BorderSizePixel = 0,
                    ZIndex = 11
                }, {
                    New("UICorner", { CornerRadius = UDim.new(1, 0) }),
                    New("Frame", {
                        Name = "Fill",
                        Size = UDim2.new((CurrentValue - minVal) / (math.max(1, (maxVal - minVal))), 0, 1, 0),
                        BackgroundColor3 = Color3.fromRGB(80, 180, 255),
                        BorderSizePixel = 0,
                        Active = false,
                        ZIndex = 12
                    }, {
                        New("UICorner", { CornerRadius = UDim.new(1, 0) }),
                        New("UIGradient", {
                            Color = ColorSequence.new({
                                ColorSequenceKeypoint.new(0, Color3.fromRGB(100, 200, 255)),
                                ColorSequenceKeypoint.new(1, Color3.fromRGB(60, 150, 240))
                            }),
                            Rotation = 0
                        })
                    }),
                    New("Frame", {
                        Name = "Thumb",
                        Size = UDim2.new(0, 18, 0, 18),
                        Position = UDim2.new((CurrentValue - minVal) / (math.max(1, (maxVal - minVal))), -9, 0.5, -9),
                        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                        BorderSizePixel = 0,
                        Active = false,
                        ZIndex = 13
                    }, {
                        New("UICorner", { CornerRadius = UDim.new(1, 0) }),
                        New("UIStroke", { Color = Color3.fromRGB(80, 180, 255), Thickness = 2 })
                    })
                })
            })

            local Track = SliderFrame.Track
            local Fill = Track.Fill
            local Thumb = Track.Thumb
            local ValueLabel = SliderFrame.ValueLabel
            local dragging = false

            local function UpdateSlider(mouseX)
                local trackX = Track.AbsolutePosition.X
                local trackWidth = Track.AbsoluteSize.X
                local relX = math.clamp(mouseX - trackX, 0, trackWidth)
                local denom = math.max(1, (maxVal - minVal))
                CurrentValue = math.floor(minVal + denom * (relX / trackWidth) + 0.5)
                ValueLabel.Text = tostring(CurrentValue)
                local fillRatio = (CurrentValue - minVal) / denom
                Fill.Size = UDim2.new(fillRatio, 0, 1, 0)
                Thumb.Position = UDim2.new(fillRatio, -9, 0.5, -9)
            end

            Track.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    UpdateSlider(input.Position.X)
                    Tween(Thumb, TweenInfo.new(0.1), { Size = UDim2.new(0, 22, 0, 22), Position = UDim2.new(Thumb.Position.X.Scale, -11, 0.5, -11) })
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) and dragging then
                    UpdateSlider(input.Position.X)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    if dragging then
                        dragging = false
                        Tween(Thumb, TweenInfo.new(0.1), { Size = UDim2.new(0, 18, 0, 18), Position = UDim2.new(Thumb.Position.X.Scale, -9, 0.5, -9) })
                        if configKey then
                            Window:_saveElement(configKey, CurrentValue)
                        end
                        callback(CurrentValue)
                    end
                end
            end)

            SliderFrame.Parent = Tab.Content
            return {
                ElementFrame = SliderFrame,
                GetValue = function() return CurrentValue end,
                SetValue = function(_, val)
                    CurrentValue = math.clamp(val, minVal, maxVal)
                    ValueLabel.Text = tostring(CurrentValue)
                    local fillRatio = (CurrentValue - minVal) / math.max(1, (maxVal - minVal))
                    Fill.Size = UDim2.new(fillRatio, 0, 1, 0)
                    Thumb.Position = UDim2.new(fillRatio, -9, 0.5, -9)
                    if configKey then
                        Window:_saveElement(configKey, CurrentValue)
                    end
                    callback(CurrentValue)
                end
            }
        end

        table.insert(Window.Tabs, Tab)
        return Tab
    end

    -- ========== SIDEBAR SECTION (winsec) ==========
    function Window:Section(sectionConfig)
        sectionConfig = sectionConfig or {}
        local sectionTitle = sectionConfig.title or "Section"
        local collapsed = sectionConfig.collapsed or false
        local def = sectionConfig.Def
        if def == true then collapsed = false end
        if def == false then collapsed = true end

        local SectionFrame = New("Frame", {
            Size = UDim2.new(1, -8, 0, 34),
            BackgroundColor3 = Color3.fromRGB(28, 28, 36),
            BorderSizePixel = 0,
            AutomaticSize = Enum.AutomaticSize.Y,
            ZIndex = 11
        }, {
            New("UICorner", { CornerRadius = UDim.new(0, 8) }),
            New("UIListLayout", {
                SortOrder = Enum.SortOrder.LayoutOrder,
                Padding = UDim.new(0, 4)
            })
        })

        local Header = New("TextButton", {
            Size = UDim2.new(1, 0, 0, 32),
            BackgroundColor3 = Color3.fromRGB(32, 32, 42),
            AutoButtonColor = false,
            Text = "",
            BorderSizePixel = 0,
            ZIndex = 12
        }, {
            New("UICorner", { CornerRadius = UDim.new(0, 6) }),
            New("TextLabel", {
                Text = sectionTitle,
                TextColor3 = Color3.fromRGB(255, 255, 255),
                Font = Enum.Font.GothamSemibold,
                TextSize = 13,
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 10, 0, 0),
                Size = UDim2.new(1, -36, 1, 0),
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 13
            }),
            New("TextLabel", {
                Name = "Arrow",
                Text = collapsed and ">" or "v",
                TextColor3 = Color3.fromRGB(160, 160, 180),
                Font = Enum.Font.GothamBold,
                TextSize = 12,
                BackgroundTransparency = 1,
                Position = UDim2.new(1, -22, 0, 0),
                Size = UDim2.new(0, 20, 1, 0),
                ZIndex = 13
            })
        })

        Header.MouseEnter:Connect(function()
            Tween(Header, TweenInfo.new(0.15), { BackgroundColor3 = Color3.fromRGB(38, 38, 50) })
        end)
        Header.MouseLeave:Connect(function()
            Tween(Header, TweenInfo.new(0.15), { BackgroundColor3 = Color3.fromRGB(32, 32, 42) })
        end)

        local TabContainer = New("Frame", {
            Size = UDim2.new(1, 0, 0, 0),
            BackgroundTransparency = 1,
            Visible = not collapsed,
            AutomaticSize = Enum.AutomaticSize.Y,
            ZIndex = 11
        }, {
            New("UIListLayout", {
                SortOrder = Enum.SortOrder.LayoutOrder,
                Padding = UDim.new(0, 4)
            }),
            New("UIPadding", {
                PaddingLeft = UDim.new(0, 8),
                PaddingRight = UDim.new(0, 8),
                PaddingBottom = UDim.new(0, 4)
            })
        })
        Header.Parent = SectionFrame
        TabContainer.Parent = SectionFrame
        SectionFrame.Parent = Sidebar

        local isCollapsed = collapsed
        Header.MouseButton1Click:Connect(function()
            isCollapsed = not isCollapsed
            TabContainer.Visible = not isCollapsed
            if isCollapsed then
                Tween(Header.Arrow, TweenInfo.new(0.2), { Rotation = -90, Text = ">" })
            else
                Tween(Header.Arrow, TweenInfo.new(0.2), { Rotation = 0, Text = "v" })
            end
        end)

        local Section = {
            Container = TabContainer,
            Tab = function(_, tabConfig)
                local tabTitle = tabConfig.title or "Tab"
                local TabButton = New("TextButton", {
                    Size = UDim2.new(1, 0, 0, 32),
                    BackgroundColor3 = Color3.fromRGB(40, 40, 50),
                    AutoButtonColor = false,
                    Text = "",
                    BorderSizePixel = 0,
                    ZIndex = 12
                }, {
                    New("UICorner", { CornerRadius = UDim.new(0, 6) }),
                    New("TextLabel", {
                        Text = tabTitle,
                        TextColor3 = Color3.fromRGB(200, 200, 215),
                        Font = Enum.Font.GothamSemibold,
                        TextSize = 13,
                        BackgroundTransparency = 1,
                        Size = UDim2.new(1, 0, 1, 0),
                        TextXAlignment = Enum.TextXAlignment.Center,
                        ZIndex = 13
                    })
                })

                TabButton.MouseEnter:Connect(function()
                    if not TabButton:GetAttribute("Selected") then
                        Tween(TabButton, TweenInfo.new(0.15), { BackgroundColor3 = Color3.fromRGB(50, 50, 62) })
                    end
                end)
                TabButton.MouseLeave:Connect(function()
                    if not TabButton:GetAttribute("Selected") then
                        Tween(TabButton, TweenInfo.new(0.15), { BackgroundColor3 = Color3.fromRGB(40, 40, 50) })
                    end
                end)

                TabButton.Parent = TabContainer

                local TabContent = New("ScrollingFrame", {
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1,
                    ScrollBarThickness = 4,
                    CanvasSize = UDim2.new(0, 0, 0, 0),
                    AutomaticCanvasSize = Enum.AutomaticSize.Y,
                    Visible = #Window.Tabs == 0,
                    ZIndex = 10
                }, {
                    New("UIListLayout", {
                        SortOrder = Enum.SortOrder.LayoutOrder,
                        Padding = UDim.new(0, 10)
                    }),
                    New("UIPadding", {
                        PaddingTop = UDim.new(0, 6),
                        PaddingLeft = UDim.new(0, 6),
                        PaddingRight = UDim.new(0, 6),
                        PaddingBottom = UDim.new(0, 6)
                    })
                })
                TabContent.Parent = PanelScroll

                if #Window.Tabs == 0 then
                    TabButton:SetAttribute("Selected", true)
                    TabButton.BackgroundColor3 = Color3.fromRGB(55, 55, 68)
                end

                TabButton.MouseButton1Click:Connect(function()
                    for _, t in ipairs(Window.Tabs) do
                        t.Content.Visible = false
                        t.Button:SetAttribute("Selected", false)
                        Tween(t.Button, TweenInfo.new(0.15), { BackgroundColor3 = Color3.fromRGB(40, 40, 50) })
                    end
                    TabContent.Visible = true
                    TabButton:SetAttribute("Selected", true)
                    Tween(TabButton, TweenInfo.new(0.2), { BackgroundColor3 = Color3.fromRGB(55, 55, 68) })
                end)

                local Tab = {
                    Content = TabContent,
                    Button = TabButton
                }

                -- Copy methods from main Tab
                for name, func in pairs(Window:Tab({title = ""})) do
                    if type(func) == "function" then
                        Tab[name] = func
                    end
                end

                table.insert(Window.Tabs, Tab)
                return Tab
            end
        }

        return Section
    end

    return Window
end

return SuperLib
