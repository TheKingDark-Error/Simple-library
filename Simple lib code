    local position = data.position or "TopRight"
    local stack = NotifyStacks[position]

    while #stack >= NotifyMaxStack do
        local old = table.remove(stack, 1)
        if old and old.Frame then
            pcall(function()
                Tween(old.Frame, { Position = old.Frame.Position + UDim2.new(0, 300, 0, 0) }, 0.25)
                Tween(old.Frame, { BackgroundTransparency = 1 }, 0.25)
