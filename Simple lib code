        -- ========== SLIDER (Integer) ==========
        function Tab:Slider(sliderConfig)
            local sTitle = sliderConfig.title or "Slider"
            local sDesc = sliderConfig.desc or ""
            local min = sliderConfig.min or 0
            local max = sliderConfig.max or 100
            local default = sliderConfig.default or min
            local callback = sliderConfig[1] or function() end
            local configKey = sliderConfig.configKey
            local tooltipText = sliderConfig.tooltip or ""
            local minVal = tonumber(min) or 0
            local maxVal = tonumber(max) or 0
            if maxVal < minVal then maxVal = minVal end

            local savedValue = nil
            if configKey and Window._autoSave then
                savedValue = Window:_getElement(configKey, nil)
            end
            local CurrentValue = savedValue ~= nil and math.clamp(savedValue, minVal, maxVal) or math.clamp(default, minVal, maxVal)

            local SliderFrame = New("Frame", {
                Size = UDim2.new(1, 0, 0, 52),
                BackgroundColor3 = theme.elementBg,
                BorderSizePixel = 0
            }, {
                New("UICorner", { CornerRadius = UDim.new(0, 6) }),
                New("TextLabel", {
                    Name = "Title",
                    Text = sTitle,
                    TextColor3 = theme.text,
                    Font = Enum.Font.GothamBold,
                    TextSize = 15,
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 12, 0, 4),
                    Size = UDim2.new(1, -24, 0, 16)
                }),
                New("TextLabel", {
                    Name = "Desc",
                    Text = sDesc,
                    TextColor3 = theme.textSecondary,
                    Font = Enum.Font.Gotham,
                    TextSize = 12,
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 12, 0, 20),
                    Size = UDim2.new(1, -24, 0, 14)
                }),
                New("TextLabel", {
                    Name = "ValueLabel",
                    Text = tostring(CurrentValue),
                    TextColor3 = Color3.fromRGB(220, 220, 230),
                    Font = Enum.Font.GothamSemibold,
                    TextSize = 14,
                    BackgroundTransparency = 1,
                    Position = UDim2.new(1, -40, 0, 36),
                    Size = UDim2.new(0, 40, 0, 14),
                    TextXAlignment = Enum.TextXAlignment.Right
                }),
                New("Frame", {
                    Name = "Track",
                    Size = UDim2.new(1, -24, 0, 4),
                    Position = UDim2.new(0, 12, 0, 36),
                    BackgroundColor3 = theme.track,
                    BorderSizePixel = 0
                }, {
                    New("UICorner", { CornerRadius = UDim.new(1, 0) }),
                    New("Frame", {
                        Name = "Fill",
                        Size = UDim2.new((CurrentValue - minVal) / (math.max(1, (maxVal - minVal))), 0, 1, 0),
                        BackgroundColor3 = theme.sliderFill,
                        BorderSizePixel = 0,
                        Active = false
                    }, {
                        New("UICorner", { CornerRadius = UDim.new(1, 0) })
                    }),
                    New("Frame", {
                        Name = "Thumb",
                        Size = UDim2.new(0, 16, 0, 16),
                        Position = UDim2.new((CurrentValue - minVal) / (math.max(1, (maxVal - minVal))), -8, 0.5, -8),
                        BackgroundColor3 = theme.thumb,
                        BorderSizePixel = 0,
                        Active = false
                    }, {
                        New("UICorner", { CornerRadius = UDim.new(1, 0) })
                    })
                })
            })

            local Track = SliderFrame.Track
            local Fill = Track.Fill
            local Thumb = Track.Thumb
            local ValueLabel = SliderFrame.ValueLabel
            local sDragging = false

            local function UpdateSlider(mouseX)
                local trackX = Track.AbsolutePosition.X
                local trackWidth = Track.AbsoluteSize.X
                local relX = math.clamp(mouseX - trackX, 0, trackWidth)
                local denom = math.max(1, (maxVal - minVal))
                CurrentValue = math.floor(minVal + denom * (relX / trackWidth) + 0.5)
                ValueLabel.Text = tostring(CurrentValue)
                local fillRatio = (CurrentValue - minVal) / denom
                Fill.Size = UDim2.new(fillRatio, 0, 1, 0)
                Thumb.Position = UDim2.new(fillRatio, -8, 0.5, -8)
            end

            Track.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    sDragging = true
                    UpdateSlider(input.Position.X)
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) and sDragging then
                    UpdateSlider(input.Position.X)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    if sDragging then
                        sDragging = false
                        if configKey then
                            Window:_saveElement(configKey, CurrentValue)
                        end
                        callback(CurrentValue)
                    end
                end
            end)

            AttachTooltip(SliderFrame, tooltipText)
            SliderFrame.Parent = Tab.Content
            return {
                ElementFrame = SliderFrame,
                GetValue = function() return CurrentValue end,
                SetValue = function(_, val)
                    CurrentValue = math.clamp(val, minVal, maxVal)
                    ValueLabel.Text = tostring(CurrentValue)
                    local fillRatio = (CurrentValue - minVal) / math.max(1, (maxVal - minVal))
                    Fill.Size = UDim2.new(fillRatio, 0, 1, 0)
                    Thumb.Position = UDim2.new(fillRatio, -8, 0.5, -8)
                    if configKey then
                        Window:_saveElement(configKey, CurrentValue)
                    end
                    callback(CurrentValue)
                end
            }
        end

