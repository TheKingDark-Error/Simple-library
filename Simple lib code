                        Tween(ContentFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad), { Size = UDim2.new(1, 0, 0, ContentFrame.AbsoluteSize.Y) })
                    end
                else
                    for _, dd in ipairs(_dropdownsInSection) do
                        if dd and dd.Visible then
                            dd.Visible = false
                        end
                    end
                    if animate then
                        Tween(ArrowButton, TweenInfo.new(0.2), { Rotation = -90, Text = ">" })
                        Tween(ContentFrame, TweenInfo.new(0.2), { Size = UDim2.new(1, 0, 0, 0) }, function()
                            ContentFrame.Visible = false
                        end)
                    else
                        ArrowButton.Text = ">"
                        ArrowButton.Rotation = -90
                        ContentFrame.Visible = false
                    end
                end
            end

            ArrowButton.MouseButton1Click:Connect(function()
                IsOpen = not IsOpen
                UpdateSection(true)
            end)

            local Section = {
                Content = ContentFrame,
                _dropdowns = _dropdownsInSection,
                IsOpen = function() return IsOpen end,
                SetOpen = function(_, open)
                    IsOpen = open
                    UpdateSection(true)
                end
            }

            for name, func in pairs(Tab) do
                if type(func) == "function" and name ~= "Section" then
                    Section[name] = function(_, config)
                        local prevContent = Tab.Content
                        Tab.Content = ContentFrame
                        local ok, result = pcall(function()
                            return func(Tab, config)
                        end)
                        Tab.Content = prevContent
                        if not ok then
                            warn(("SuperLib: error calling Tab.%s: %s"):format(name, tostring(result)))
                            return nil
                        end
                        if result and type(result) == "table" then
                            if result.ElementFrame and result.ElementFrame.Parent ~= ContentFrame then
                                result.ElementFrame.Parent = ContentFrame
                            elseif result.Parent and result.Parent ~= ContentFrame then
                                result.Parent = ContentFrame
                            end
                            if result._dropdownMenu then
                                table.insert(_dropdownsInSection, result._dropdownMenu)
                            end
                        end
                        return result
                    end
                end
            end

            UpdateSection(false)
            return Section
        end

