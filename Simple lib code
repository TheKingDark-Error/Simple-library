            local IsOpen = defaultState
            local function UpdateSection()
                if IsOpen then
                    ContentFrame.Visible = true
                    ContentFrame.Size = UDim2.new(1, 0, 0, 0)
                    Tween(ArrowButton, { Rotation = 180 }, 0.25, Enum.EasingStyle.Back)
                    Tween(ContentFrame, { BackgroundTransparency = 0 }, 0.2)
                else
                    Tween(ArrowButton, { Rotation = 0 }, 0.25, Enum.EasingStyle.Back)
                    Tween(ContentFrame, { BackgroundTransparency = 1 }, 0.15)
                    task.delay(0.15, function()
                        if not IsOpen then ContentFrame.Visible = false end
                    end)
                end
            end

            ArrowButton.MouseButton1Click:Connect(function()
                IsOpen = not IsOpen
                UpdateSection()
            end)

            SectionFrame.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    IsOpen = not IsOpen
                    UpdateSection()
                end
            end)

            local Section = { Content = ContentFrame }

            for name, func in pairs(Tab) do
                if type(func) == "function" and name ~= "Section" and name ~= "SetSearchQuery" then
                    Section[name] = function(_, config)
                        local prevContent = Tab.Content
                        Tab.Content = ContentFrame
                        local ok, result = pcall(function()
                            return func(Tab, config)
                        end)
                        Tab.Content = prevContent
                        if not ok then
                            warn(("SimpleLib: error calling Tab.%s: %s"):format(name, tostring(result)))
                            return nil
                        end
                        if result and type(result) == "table" then
                            if result.ElementFrame and result.ElementFrame.Parent ~= ContentFrame then
                                result.ElementFrame.Parent = ContentFrame
                            elseif result.Parent and result.Parent ~= ContentFrame then
                                result.Parent = ContentFrame
                            end
                        end
                        return result
                    end
                end
            end

            UpdateSection()
            return Section
        end

