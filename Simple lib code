local function HideTooltip()
    TooltipFrame.Visible = false
end

local function AttachTooltip(element, text)
    if not text or text == "" then return end
    element.MouseEnter:Connect(function()
        ShowTooltip(text)
    end)
    element.MouseLeave:Connect(function()
        HideTooltip()
    end)
    element.MouseMoved:Connect(function()
        local mousePos = UserInputService:GetMouseLocation()
        TooltipFrame.Position = UDim2.new(0, mousePos.X + 15, 0, mousePos.Y + 15)
    end)
end

-- ========== CONFIG SYSTEM ==========
function SuperLib:LoadConfig()
    local success, result = pcall(function()
        if writefile and readfile and isfile then
            if isfile(self._configPath) then
                local data = HttpService:JSONDecode(readfile(self._configPath))
                if type(data) == "table" and data._version == self._configVersion then
                    return data
                end
            end
        end
        return { _version = self._configVersion }
    end)
    if success then
        self._configCache = result or { _version = self._configVersion }
    else
        self._configCache = { _version = self._configVersion }
    end
    return self._configCache
end

function SuperLib:SaveConfig(data)
    self._configCache = data or self._configCache or { _version = self._configVersion }
    self._configCache._version = self._configVersion
    pcall(function()
        if writefile then
            writefile(self._configPath, HttpService:JSONEncode(self._configCache))
        end
    end)
end

function SuperLib:GetConfigValue(key, default)
    if not self._configCache then
        self:LoadConfig()
    end
    local val = self._configCache[key]
    if val == nil then
        return default
    end
    return val
end

function SuperLib:SetConfigValue(key, value)
    if not self._configCache then
        self:LoadConfig()
    end
    self._configCache[key] = value
    self:SaveConfig()
end

