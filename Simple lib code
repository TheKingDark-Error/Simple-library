                    local btn = MakeItemButton(item, 1001)
                    btn.Parent = SideScroll
                    table.insert(ItemButtons, { Button = btn, Text = string.lower(tostring(item)) })
                end
                HookSearch()

                local followConn = nil
                local function GetSidePosition()
                    local mfPos = MainFrame.AbsolutePosition
                    local mfSize = MainFrame.AbsoluteSize
                    local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080)
                    local x = mfPos.X + mfSize.X + 8
                    if x + SideWidth > viewport.X - 8 then
                        x = mfPos.X - SideWidth - 8
                        if x < 8 then x = math.max(8, viewport.X - SideWidth - 8) end
                    end
                    return UDim2.new(0, x, 0, mfPos.Y)
                end

                OpenDropdown = function()
                    if IsOpen then return end
                    IsOpen = true
                    if DdSearchBox then
                        DdSearchBox.Text = ""
                        for _, data in ipairs(ItemButtons) do data.Button.Visible = true end
                    end
                    local maxH = math.max(MainFrame.AbsoluteSize.Y - 16, 140)
                    local targetHeight = math.min(CountVisible() * 28 + (searchEnabled and 34 or 0) + 12, maxH)
                    SidePanel.Position = GetSidePosition()
                    SidePanel.Size = UDim2.new(0, SideWidth, 0, 0)
                    SidePanel.Visible = true
                    SidePanel.BackgroundTransparency = 1

                    local scale = Instance.new("UIScale")
                    scale.Scale = 0.9
                    scale.Parent = SidePanel

                    Tween(SidePanel, { Size = UDim2.new(0, SideWidth, 0, targetHeight), BackgroundTransparency = 0 }, 0.25, Enum.EasingStyle.Quad)
                    SpringTween(scale, { Scale = 1 }, 0.25)
                    game:GetService("Debris"):AddItem(scale, 0.3)
                    Tween(ArrowIcon, { Rotation = 180 }, 0.2)

                    if followConn then followConn:Disconnect() end
                    followConn = RunService.RenderStepped:Connect(function()
                        if IsOpen and SidePanel.Visible then
                            SidePanel.Position = GetSidePosition()
                        end
                    end)
                end

                CloseDropdown = function()
                    if not IsOpen then return end
                    IsOpen = false
                    if followConn then followConn:Disconnect() followConn = nil end
                    Tween(SidePanel, { Size = UDim2.new(0, SideWidth, 0, 0), BackgroundTransparency = 1 }, 0.2, Enum.EasingStyle.Quad)
                    Tween(ArrowIcon, { Rotation = 0 }, 0.15)
                    task.delay(0.2, function()
                        if not IsOpen then SidePanel.Visible = false end
                    end)
                end

                UserInputService.InputBegan:Connect(function(input)
                    if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and IsOpen then
                        local mousePos = UserInputService:GetMouseLocation()
                        local menuAbs = SidePanel.AbsolutePosition
                        local menuSize = SidePanel.AbsoluteSize
                        local inMenu = mousePos.X >= menuAbs.X and mousePos.X <= menuAbs.X + menuSize.X and
                                       mousePos.Y >= menuAbs.Y and mousePos.Y <= menuAbs.Y + menuSize.Y
                        local btnAbs = SelectedBtn.AbsolutePosition
                        local btnSize = SelectedBtn.AbsoluteSize
                        local inBtn = mousePos.X >= btnAbs.X and mousePos.X <= btnAbs.X + btnSize.X and
                                      mousePos.Y >= btnAbs.Y and mousePos.Y <= btnAbs.Y + btnSize.Y
                        if not inMenu and not inBtn then
                            CloseDropdown()
                        end
                    end
                end)
            end

            SelectedBtn.MouseButton1Click:Connect(function()
                if IsOpen then CloseDropdown() else OpenDropdown() end
            end)

            DDFrame.Parent = Tab.Content

            table.insert(Tab.Elements, {
                Frame = DDFrame,
                Searchable = true,
                SearchText = title .. " " .. table.concat(items, " "),
            })

            return {
                Set = function(val)
                    SelectedItem = val
                    SelectedBtn.Text = tostring(val)
                    callback(val)
                end,
                Get = function() return SelectedItem end,
            }
        end
