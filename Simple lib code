-- ========== UTILITY ==========
local function New(Class, Props, Children)
    local obj = Instance.new(Class)
    for k, v in pairs(Props or {}) do
        obj[k] = v
    end
    for _, child in ipairs(Children or {}) do
        child.Parent = obj
    end
    return obj
end

local function Tween(obj, info, props, callback)
    local tween = TweenService:Create(obj, info or TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
    tween:Play()
    if callback then
        tween.Completed:Connect(callback)
    end
    return tween
end

-- ========== CONFIG SYSTEM ==========
function SuperLib:LoadConfig()
    local success, result = pcall(function()
        if writefile and readfile and isfile then
            if isfile(self._configPath) then
                return HttpService:JSONDecode(readfile(self._configPath))
            end
        end
        return {}
    end)
    if success then
        self._configCache = result or {}
    else
        self._configCache = {}
    end
    return self._configCache
end

function SuperLib:SaveConfig(data)
    self._configCache = data or self._configCache or {}
    pcall(function()
        if writefile then
            writefile(self._configPath, HttpService:JSONEncode(self._configCache))
        end
    end)
end

function SuperLib:GetConfigValue(key, default)
    if not self._configCache then
        self:LoadConfig()
    end
    local val = self._configCache[key]
    if val == nil then
        return default
    end
    return val
end

function SuperLib:SetConfigValue(key, value)
    if not self._configCache then
        self:LoadConfig()
    end
    self._configCache[key] = value
    self:SaveConfig()
end

