    function Window:_saveElement(key, value)
        if not self._autoSave then return end
        local cfg = SuperLib:GetConfigValue(self._configId, {})
        if type(cfg) ~= "table" then cfg = {} end
        cfg[key] = value
        SuperLib:SetConfigValue(self._configId, cfg)
    end

    function Window:_getElement(key, default)
        if not self._autoSave then return default end
        local cfg = SuperLib:GetConfigValue(self._configId, {})
        if type(cfg) ~= "table" then return default end
        local val = cfg[key]
        if val == nil then return default end
        return val
    end

    function Window:Destroy()
        if keybindConnection then
            keybindConnection:Disconnect()
            keybindConnection = nil
        end
        if MiniBar then MiniBar:Destroy() end
        MainFrame:Destroy()
    end

    function Window:SetKeybind(kb)
        SetupKeybind(kb)
    end

