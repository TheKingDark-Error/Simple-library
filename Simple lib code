-- ========== UTILITY ==========
local function New(Class, Props, Children)
    local obj = Instance.new(Class)
    for k, v in pairs(Props or {}) do
        obj[k] = v
    end
    for _, child in ipairs(Children or {}) do
        child.Parent = obj
    end
    return obj
end

local function Tween(obj, info, props, callback)
    local tween = TweenService:Create(obj, info or TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
    tween:Play()
    if callback then
        tween.Completed:Connect(callback)
    end
    return tween
end

