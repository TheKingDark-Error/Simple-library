        function Tab:Slider(sliderConfig)
            theme = GetTheme()
            local title = sliderConfig.title or "Slider"
            local desc = sliderConfig.desc or ""
            local min = sliderConfig.min or 0
            local max = sliderConfig.max or 100
            local default = sliderConfig.default or min
            local callback = sliderConfig[1] or function() end
            local minVal = tonumber(min) or 0
            local maxVal = tonumber(max) or 0
            if maxVal < minVal then maxVal = minVal end
            local CurrentValue = math.clamp(default, minVal, maxVal)

            local SliderFrame = New("Frame", {
                Size = UDim2.new(1, 0, 0, 56),
                BackgroundColor3 = theme.Element,
                BorderSizePixel = 0
            }, {
                New("UICorner", { CornerRadius = UDim.new(0, 8) }),
                New("TextLabel", {
                    Name = "Title",
                    Text = title,
                    TextColor3 = theme.TextPrimary,
                    Font = Enum.Font.GothamBold,
                    TextSize = 15,
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 14, 0, 6),
                    Size = UDim2.new(1, -80, 0, 16)
                }),
                New("TextLabel", {
                    Name = "Desc",
                    Text = desc,
                    TextColor3 = theme.TextSecondary,
                    Font = Enum.Font.Gotham,
                    TextSize = 12,
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 14, 0, 22),
                    Size = UDim2.new(1, -80, 0, 14)
                }),
                New("TextButton", {
                    Name = "ValueLabel",
                    Text = tostring(CurrentValue),
                    TextColor3 = theme.TextPrimary,
                    Font = Enum.Font.GothamBold,
                    TextSize = 14,
                    BackgroundColor3 = theme.InputBg,
                    BorderSizePixel = 0,
                    Position = UDim2.new(1, -50, 0, 6),
                    Size = UDim2.new(0, 44, 0, 24),
                    AutoButtonColor = false,
                    TextXAlignment = Enum.TextXAlignment.Center
                }, {
                    New("UICorner", { CornerRadius = UDim.new(0, 6) })
                }),
                New("Frame", {
                    Name = "Track",
                    Size = UDim2.new(1, -28, 0, 5),
                    Position = UDim2.new(0, 14, 0, 40),
                    BackgroundColor3 = theme.Track,
                    BorderSizePixel = 0
                }, {
                    New("UICorner", { CornerRadius = UDim.new(1, 0) }),
                    New("Frame", {
                        Name = "Fill",
                        Size = UDim2.new((CurrentValue - minVal) / (math.max(1, (maxVal - minVal))), 0, 1, 0),
                        BackgroundColor3 = theme.TrackFill,
                        BorderSizePixel = 0,
                        Active = false
                    }, {
                        New("UICorner", { CornerRadius = UDim.new(1, 0) })
                    }),
                    New("TextButton", {
                        Name = "Thumb",
                        Size = UDim2.new(0, 18, 0, 18),
                        Position = UDim2.new((CurrentValue - minVal) / (math.max(1, (maxVal - minVal))), -9, 0.5, -9),
                        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                        BorderSizePixel = 0,
                        AutoButtonColor = false,
                        Active = false,
                        Text = ""
                    }, {
                        New("UICorner", { CornerRadius = UDim.new(1, 0) }),
                        New("UIStroke", { Color = theme.TrackFill, Thickness = 2 })
                    })
                })
            })

            local Track = SliderFrame.Track
            local Fill = Track.Fill
            local Thumb = Track.Thumb
            local ValueLabel = SliderFrame.ValueLabel
            local dragging = false

            local function UpdateSlider(mouseX, animate)
                animate = animate ~= false
                local trackX = Track.AbsolutePosition.X
                local trackWidth = Track.AbsoluteSize.X
                local relX = math.clamp(mouseX - trackX, 0, trackWidth)
                local denom = math.max(1, (maxVal - minVal))
                CurrentValue = math.floor(minVal + denom * (relX / trackWidth) + 0.5)
                ValueLabel.Text = tostring(CurrentValue)
                local fillRatio = (CurrentValue - minVal) / denom

                if animate then
                    Tween(Fill, { Size = UDim2.new(fillRatio, 0, 1, 0) }, 0.1)
                    Tween(Thumb, { Position = UDim2.new(fillRatio, -9, 0.5, -9) }, 0.1, Enum.EasingStyle.Back)
                else
                    Fill.Size = UDim2.new(fillRatio, 0, 1, 0)
                    Thumb.Position = UDim2.new(fillRatio, -9, 0.5, -9)
                end
            end

            Track.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    UpdateSlider(input.Position.X)
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) and dragging then
                    UpdateSlider(input.Position.X)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    if dragging then
                        dragging = false
                        callback(CurrentValue)
                    end
                end
            end)

            -- Number input on value label click
            local NumberInput
            ValueLabel.MouseButton1Click:Connect(function()
                if NumberInput then return end

                NumberInput = New("TextBox", {
                    Size = UDim2.new(0, 60, 0, 28),
                    Position = UDim2.new(1, -66, 0, 4),
                    BackgroundColor3 = theme.Button,
                    BorderSizePixel = 0,
                    Text = tostring(CurrentValue),
                    TextColor3 = theme.TextPrimary,
                    Font = Enum.Font.GothamBold,
                    TextSize = 14,
                    TextXAlignment = Enum.TextXAlignment.Center,
                    ClearTextOnFocus = true,
                    ZIndex = 50
                }, {
                    New("UICorner", { CornerRadius = UDim.new(0, 6) }),
                    New("UIStroke", { Color = theme.Accent, Thickness = 2 })
                })
                NumberInput.Parent = SliderFrame
                NumberInput:CaptureFocus()

                NumberInput.FocusLost:Connect(function()
                    local num = tonumber(NumberInput.Text)
                    if num then
                        CurrentValue = math.clamp(math.floor(num + 0.5), minVal, maxVal)
                        ValueLabel.Text = tostring(CurrentValue)
                        local fillRatio = (CurrentValue - minVal) / math.max(1, (maxVal - minVal))
                        Tween(Fill, { Size = UDim2.new(fillRatio, 0, 1, 0) }, 0.2)
                        Tween(Thumb, { Position = UDim2.new(fillRatio, -9, 0.5, -9) }, 0.2, Enum.EasingStyle.Back)
                        callback(CurrentValue)
                    end
                    NumberInput:Destroy()
                    NumberInput = nil
                end)
            end)

            ValueLabel.MouseEnter:Connect(function()
                Tween(ValueLabel, { BackgroundColor3 = theme.ButtonHover }, 0.15)
            end)
            ValueLabel.MouseLeave:Connect(function()
                Tween(ValueLabel, { BackgroundColor3 = theme.InputBg }, 0.15)
            end)

            SliderFrame.Parent = Tab.Content

            table.insert(Tab.Elements, {
                Frame = SliderFrame,
                Searchable = true,
                SearchText = title .. " " .. desc
            })

            return {
                Set = function(val)
                    CurrentValue = math.clamp(math.floor(val + 0.5), minVal, maxVal)
                    ValueLabel.Text = tostring(CurrentValue)
                    local fillRatio = (CurrentValue - minVal) / math.max(1, (maxVal - minVal))
                    Tween(Fill, { Size = UDim2.new(fillRatio, 0, 1, 0) }, 0.2)
                    Tween(Thumb, { Position = UDim2.new(fillRatio, -9, 0.5, -9) }, 0.2, Enum.EasingStyle.Back)
                    callback(CurrentValue)
                end,
                Get = function() return CurrentValue end
            }
        end

        return Tab
    end

    -- ========== SIDEBAR SECTION (winsec) ==========
    function Window:Section(sectionConfig)
        theme = GetTheme()
        local sectionTitle = sectionConfig.title or "Section"
        local collapsed = sectionConfig.collapsed or false

        local SectionFrame = New("Frame", {
            Size = UDim2.new(1, -8, 0, 34),
            BackgroundColor3 = theme.SectionHeader,
            BorderSizePixel = 0,
            AutomaticSize = Enum.AutomaticSize.Y
        }, {
            New("UICorner", { CornerRadius = UDim.new(0, 8) }),
            New("UIListLayout", {
                SortOrder = Enum.SortOrder.LayoutOrder,
                Padding = UDim.new(0, 2)
            })
        })

        local Header = New("TextButton", {
            Size = UDim2.new(1, 0, 0, 30),
            BackgroundColor3 = theme.SectionHeader,
            AutoButtonColor = false,
            Text = "",
            BorderSizePixel = 0
        }, {
            New("UICorner", { CornerRadius = UDim.new(0, 6) }),
            New("TextLabel", {
                Text = sectionTitle,
                TextColor3 = theme.TextPrimary,
                Font = Enum.Font.GothamSemibold,
                TextSize = 14,
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 10, 0, 0),
                Size = UDim2.new(1, -36, 1, 0),
                TextXAlignment = Enum.TextXAlignment.Left
            }),
            New("TextLabel", {
                Name = "Arrow",
                Text = collapsed and "▼" or "▲",
                TextColor3 = theme.TextSecondary,
                Font = Enum.Font.GothamBold,
                TextSize = 12,
                BackgroundTransparency = 1,
                Position = UDim2.new(1, -24, 0, 0),
                Size = UDim2.new(0, 20, 1, 0)
            })
        })

        local TabContainer = New("Frame", {
            Size = UDim2.new(1, 0, 0, 0),
            BackgroundTransparency = 1,
            Visible = not collapsed,
            AutomaticSize = Enum.AutomaticSize.Y
        }, {
            New("UIListLayout", {
                SortOrder = Enum.SortOrder.LayoutOrder,
                Padding = UDim.new(0, 4)
            }),
            New("UIPadding", {
                PaddingLeft = UDim.new(0, 8),
                PaddingRight = UDim.new(0, 8),
                PaddingBottom = UDim.new(0, 6)
            })
        })
        Header.Parent = SectionFrame
        TabContainer.Parent = SectionFrame
        SectionFrame.Parent = Sidebar

        local isCollapsed = collapsed
        Header.MouseButton1Click:Connect(function()
            isCollapsed = not isCollapsed
            TabContainer.Visible = not isCollapsed
            Tween(Header.Arrow, { Rotation = isCollapsed and 0 or 180 }, 0.2, Enum.EasingStyle.Back)
        end)

        local Section = {
            Container = TabContainer,
            Tab = function(_, tabConfig)
                return Window:Tab(tabConfig)
            end
        }

        return Section
    end

    -- ========== THEME SWITCHER ==========
    function Window:SetTheme(themeName)
        if SimpleLib.Themes[themeName] then
            SimpleLib.Theme = themeName
            Window:Notify({
                title = "Theme Changed",
                content = "Switched to " .. themeName .. " theme",
                dur = 3
            })
        end
    end

    return Window
end

-- ========== GLOBAL THEME SETTER ==========
function SimpleLib:SetTheme(themeName)
    if self.Themes[themeName] then
        self.Theme = themeName
    end
end

return SimpleLib
