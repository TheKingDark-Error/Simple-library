        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            svDragging = false
            hueDragging = false
        end
    end)

    HexBox.FocusLost:Connect(UpdateFromHex)
    RBox.FocusLost:Connect(UpdateColorFromBoxes)
    GBox.FocusLost:Connect(UpdateColorFromBoxes)
    BBox.FocusLost:Connect(UpdateColorFromBoxes)

    local function ClosePicker(apply)
        ActiveColorPicker = nil
        Tween(PickerFrame, { BackgroundTransparency = 1 }, 0.2)
        Tween(Backdrop, { BackgroundTransparency = 1 }, 0.2)
        task.delay(0.25, function()
            PickerFrame:Destroy()
            Backdrop:Destroy()
        end)
        if apply then
            local nr, ng, nb = HSVToRGB(h, s, v)
            callback(Color3.fromRGB(nr, ng, nb))
        end
    end

    CancelBtn.MouseButton1Click:Connect(function() ClosePicker(false) end)
    ApplyBtn.MouseButton1Click:Connect(function() ClosePicker(true) end)
