    end

    -- Theme Switcher
    function Window:SetTheme(themeName)
        if SimpleLib.Themes[themeName] then
            SimpleLib.Theme = themeName
            ApplyTheme()
            Window:Notify({
                title = "Theme Changed",
                content = "Switched to " .. themeName .. " theme",
                dur = 3,
            })
        end
    end

    return Window
end

-- Global aliases on SimpleLib
for alias, realName in pairs(Aliases) do
    if not SimpleLib[alias] and SimpleLib[realName] then
        SimpleLib[alias] = SimpleLib[realName]
    end
end

-- ========== GLOBAL THEME SETTER ==========
function SimpleLib:SetTheme(themeName)
    if self.Themes[themeName] then
        self.Theme = themeName
        ApplyTheme()
    end
end

-- ========== LOAD THEMES FROM URL ==========
function SimpleLib:LoadThemesFromURL(url)
    local success, result = pcall(function()
        return loadstring(game:HttpGet(url))()
    end)
    if success and type(result) == "table" then
        for name, theme in pairs(result) do
            self.Themes[name] = theme
        end
        return true
    end
    return false
end

return SimpleLib
