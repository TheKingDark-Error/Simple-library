    end

    local function UpdateColor()
        local nr, ng, nb = HSVToRGB(h, s, v)
        RBox.Text = tostring(nr)
        GBox.Text = tostring(ng)
        BBox.Text = tostring(nb)
        HexBox.Text = RGBToHex(nr, ng, nb)
        NewPreview.BackgroundColor3 = Color3.fromRGB(nr, ng, nb)
    end

    local svDragging = false
    SVFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            svDragging = true
            local absPos = SVFrame.AbsolutePosition
            local absSize = SVFrame.AbsoluteSize
            local relX = math.clamp((input.Position.X - absPos.X) / absSize.X, 0, 1)
            local relY = math.clamp((input.Position.Y - absPos.Y) / absSize.Y, 0, 1)
            s = relX
            v = 1 - relY
            SVCursor.Position = UDim2.new(s, -7, 1 - v, -7)
            UpdateColor()
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if svDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local absPos = SVFrame.AbsolutePosition
            local absSize = SVFrame.AbsoluteSize
            local relX = math.clamp((input.Position.X - absPos.X) / absSize.X, 0, 1)
            local relY = math.clamp((input.Position.Y - absPos.Y) / absSize.Y, 0, 1)
            s = relX
            v = 1 - relY
            SVCursor.Position = UDim2.new(s, -7, 1 - v, -7)
            UpdateColor()
        end
    end)

    local hueDragging = false
    HueFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            hueDragging = true
            local absPos = HueFrame.AbsolutePosition
            local absSize = HueFrame.AbsoluteSize
            h = math.clamp((input.Position.Y - absPos.Y) / absSize.Y, 0, 1)
            HueCursor.Position = UDim2.new(0.5, -11, h, -11)
            SVFrame.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
            UpdateColor()
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if hueDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local absPos = HueFrame.AbsolutePosition
            local absSize = HueFrame.AbsoluteSize
            h = math.clamp((input.Position.Y - absPos.Y) / absSize.Y, 0, 1)
            HueCursor.Position = UDim2.new(0.5, -11, h, -11)
            SVFrame.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
            UpdateColor()
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            svDragging = false
            hueDragging = false
        end
    end)

    HexBox.FocusLost:Connect(UpdateFromHex)
    RBox.FocusLost:Connect(UpdateColorFromBoxes)
    GBox.FocusLost:Connect(UpdateColorFromBoxes)
    BBox.FocusLost:Connect(UpdateColorFromBoxes)

    local function ClosePicker(apply)
        ActiveColorPicker = nil
        Tween(PickerFrame, { BackgroundTransparency = 1 }, 0.2)
        Tween(Backdrop, { BackgroundTransparency = 1 }, 0.2)
        task.delay(0.25, function()
