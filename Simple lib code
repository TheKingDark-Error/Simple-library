                }),
                New("TextButton", {
                    Name = "ToggleBtn",
                    Size = UDim2.new(0, 48, 0, 22),
                    Position = UDim2.new(1, -62, 0, 15),
                    BackgroundColor3 = theme.ToggleOff,
                    AutoButtonColor = false,
                    BorderSizePixel = 0,
                    Text = "",
                }, {
                    New("UICorner", { CornerRadius = UDim.new(1, 0) }),
                    New("Frame", {
                        Name = "Indicator",
