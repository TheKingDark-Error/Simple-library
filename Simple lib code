                    if key == "title" then return self._titleLabel.Text
                    elseif key == "desc" then return self._descLabel.Text end
                    return rawget(self, key)
                end,
                __newindex = function(self, key, value)
                    if key == "title" then self._titleLabel.Text = value
                    elseif key == "desc" then
                        self._descLabel.Text = value
