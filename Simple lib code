        TextColor3 = theme.TextPrimary,
        Font = Enum.Font.GothamBold,
        TextSize = 15,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        LayoutOrder = 1
    })
    
    local ContentLabel = New("TextLabel", {
        Name = "Content",
        Text = data.content,
        TextColor3 = theme.TextSecondary,
        Font = Enum.Font.Gotham,
        TextSize = 13,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        LayoutOrder = 2
    })
    
    local ProgressBar = New("Frame", {
        Name = "ProgressBar",
        Size = UDim2.new(0, 0, 0, 3),
        BackgroundColor3 = theme.ProgressBar,
        BorderSizePixel = 0,
        ZIndex = 201,
        LayoutOrder = 3
    }, { New("UICorner", { CornerRadius = UDim.new(0, 1.5) }) })
    
    TitleLabel.Parent = ContentFrame
    ContentLabel.Parent = ContentFrame
    IconFrame.Parent = NotifyFrame
    ContentFrame.Parent = NotifyFrame
    ProgressBar.Parent = NotifyFrame
    NotifyFrame.Parent = ScreenGui
    
    Tween(NotifyFrame, { BackgroundTransparency = 0 }, 0.3)
    Tween(NotifyFrame, { Position = UDim2.new(0, 10, 1, -NotifyFrame.AbsoluteSize.Y - 10) }, 0.4, Enum.EasingStyle.Back)
    
    local pbTween = Tween(ProgressBar, { Size = UDim2.new(1, 0, 0, 3) }, data.dur, Enum.EasingStyle.Linear)
    
    local CloseNotify = New("TextButton", {
        Size = UDim2.new(0, 20, 0, 20),
        Position = UDim2.new(1, -24, 0, 4),
        BackgroundTransparency = 1,
        Text = "×",
        TextColor3 = theme.TextSecondary,
        Font = Enum.Font.GothamBold,
        TextSize = 18,
        ZIndex = 202
    })
    CloseNotify.Parent = NotifyFrame
    
    local closing = false
    CloseNotify.MouseEnter:Connect(function()
        Tween(CloseNotify, { TextColor3 = theme.TextPrimary }, 0.15)
    end)
    CloseNotify.MouseLeave:Connect(function()
        Tween(CloseNotify, { TextColor3 = theme.TextSecondary }, 0.15)
    end)
    
    local function Close()
        if closing then return end
        closing = true
        pcall(function() pbTween:Cancel() end)
        Tween(NotifyFrame, { Position = UDim2.new(0, -300, 1, -NotifyFrame.AbsoluteSize.Y - 10) }, 0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        Tween(NotifyFrame, { BackgroundTransparency = 1 }, 0.25)
        task.delay(0.35, function()
            if NotifyFrame and NotifyFrame.Destroy then
                NotifyFrame:Destroy()
            end
            NotifyActive = false
            ProcessNotifyQueue()
        end)
    end
    
    CloseNotify.MouseButton1Click:Connect(Close)
    task.delay(data.dur, function()
        if not closing then Close() end
    end)
end

