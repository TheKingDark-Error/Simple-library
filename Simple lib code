            local IsOpen = not collapsed
            local _dropdownsInSection = {}

            local function UpdateSection(animate)
                animate = animate ~= false
                if IsOpen then
                    if animate then
                        Tween(ArrowButton, TweenInfo.new(0.2), { Rotation = 0, Text = "v" })
                    else
                        ArrowButton.Text = "v"
                        ArrowButton.Rotation = 0
                    end
                    ContentFrame.Visible = true
