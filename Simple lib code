            Tween(Header.Arrow, { Rotation = isCollapsed and 0 or 180 }, 0.2, Enum.EasingStyle.Back)
        end)

        local Section = { Container = TabContainer }
        Section.Tab = function(_, tabConfig) return Window:Tab(tabConfig) end
