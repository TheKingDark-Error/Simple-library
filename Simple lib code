            local function UpdateSection()
                if IsOpen then
                    ArrowButton.Text = "v"
                    ContentFrame.Visible = true
                else
                    ArrowButton.Text = ">"
                    ContentFrame.Visible = false
                    for _, dd in ipairs(_dropdownsInSection) do
                        if dd and dd.Visible then
                            dd.Visible = false
                        end
                    end
                end
            end

