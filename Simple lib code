                        Padding = UDim.new(0, 4),
                        SortOrder = Enum.SortOrder.LayoutOrder
                    })
                })
                RGBFrame.Parent = PopupFrame

                local rVal = math.floor(CurrentColor.R * 255)
                local gVal = math.floor(CurrentColor.G * 255)
                local bVal = math.floor(CurrentColor.B * 255)

                local function makeRGBInput(label, val, layoutOrder, onChange)
                    local f = New("Frame", {
                        Size = UDim2.new(0.33, -3, 1, 0),
                        BackgroundTransparency = 1,
                        LayoutOrder = layoutOrder
                    })
                    local lbl = New("TextLabel", {
                        Size = UDim2.new(1, 0, 0, 14),
                        Text = label,
                        TextColor3 = theme.textSecondary,
                        Font = Enum.Font.Gotham,
                        TextSize = 10,
                        BackgroundTransparency = 1,
                        TextXAlignment = Enum.TextXAlignment.Center
                    })
                    local box = New("TextBox", {
                        Size = UDim2.new(1, 0, 0, 20),
                        Position = UDim2.new(0, 0, 0, 14),
                        BackgroundColor3 = theme.inputBg,
                        BorderSizePixel = 0,
                        Text = tostring(val),
                        TextColor3 = theme.text,
                        Font = Enum.Font.Gotham,
                        TextSize = 12,
                        TextXAlignment = Enum.TextXAlignment.Center
                    }, {
                        New("UICorner", { CornerRadius = UDim.new(0, 4) })
                    })
                    lbl.Parent = f
                    box.Parent = f
                    box.FocusLost:Connect(function()
                        local n = tonumber(box.Text) or 0
                        n = math.clamp(math.floor(n), 0, 255)
                        box.Text = tostring(n)
                        onChange(n)
                    end)
                    return f
                end

                local rBox, gBox, bBox
                local rInput = makeRGBInput("R", rVal, 1, function(v)
                    rVal = v
                    CurrentColor = Color3.fromRGB(rVal, gVal, bVal)
                    ColorBtn.BackgroundColor3 = CurrentColor
                    if configKey then
                        Window:_saveElement(configKey, {R = CurrentColor.R, G = CurrentColor.G, B = CurrentColor.B})
                    end
                    callback(CurrentColor)
                end)
                local gInput = makeRGBInput("G", gVal, 2, function(v)
                    gVal = v
                    CurrentColor = Color3.fromRGB(rVal, gVal, bVal)
                    ColorBtn.BackgroundColor3 = CurrentColor
                    if configKey then
                        Window:_saveElement(configKey, {R = CurrentColor.R, G = CurrentColor.G, B = CurrentColor.B})
                    end
                    callback(CurrentColor)
                end)
                local bInput = makeRGBInput("B", bVal, 3, function(v)
                    bVal = v
                    CurrentColor = Color3.fromRGB(rVal, gVal, bVal)
                    ColorBtn.BackgroundColor3 = CurrentColor
                    if configKey then
                        Window:_saveElement(configKey, {R = CurrentColor.R, G = CurrentColor.G, B = CurrentColor.B})
                    end
                    callback(CurrentColor)
                end)

                rInput.Parent = RGBFrame
                gInput.Parent = RGBFrame
                bInput.Parent = RGBFrame

                local absPos = ColorBtn.AbsolutePosition
                local absSize = ColorBtn.AbsoluteSize
                PopupFrame.Position = UDim2.new(0, absPos.X - 160, 0, absPos.Y + absSize.Y + 4)
                PopupFrame.Parent = ScreenGui
                PopupOpen = true

                task.delay(0.1, function()
                    UserInputService.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 and PopupOpen and PopupFrame then
                            local mousePos = UserInputService:GetMouseLocation()
                            local pAbs = PopupFrame.AbsolutePosition
                            local pSize = PopupFrame.AbsoluteSize
                            if not (mousePos.X >= pAbs.X and mousePos.X <= pAbs.X + pSize.X and
                                    mousePos.Y >= pAbs.Y and mousePos.Y <= pAbs.Y + pSize.Y) then
                                if not (mousePos.X >= absPos.X and mousePos.X <= absPos.X + absSize.X and
                                        mousePos.Y >= absPos.Y and mousePos.Y <= absPos.Y + absSize.Y) then
                                    PopupFrame:Destroy()
                                    PopupOpen = false
                                end
                            end
                        end
                    end)
                end)
            end)

            AttachTooltip(CPFrame, tooltipText)
            CPFrame.Parent = Tab.Content
            return {
                ElementFrame = CPFrame,
                GetValue = function() return CurrentColor end,
                SetValue = function(_, color)
                    CurrentColor = color
                    ColorBtn.BackgroundColor3 = CurrentColor
                    if configKey then
                        Window:_saveElement(configKey, {R = CurrentColor.R, G = CurrentColor.G, B = CurrentColor.B})
                    end
                    callback(CurrentColor)
                end
            }
        end

