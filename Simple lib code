-- ========== UTILITY ==========
local function New(Class, Props, Children)
    local obj = Instance.new(Class)
    for k, v in pairs(Props or {}) do
        obj[k] = v
    end
    for _, child in ipairs(Children or {}) do
        child.Parent = obj
    end
    return obj
end

local function Tween(obj, info, props, callback)
    local tween = TweenService:Create(obj, info or TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
    tween:Play()
    if callback then
        tween.Completed:Connect(callback)
    end
    return tween
end

local function Ripple(button, x, y)
    local ripple = New("Frame", {
        Size = UDim2.new(0, 0, 0, 0),
        Position = UDim2.new(0, x - button.AbsolutePosition.X, 0, y - button.AbsolutePosition.Y),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BackgroundTransparency = 0.8,
        BorderSizePixel = 0,
        ZIndex = button.ZIndex + 1,
        AnchorPoint = Vector2.new(0.5, 0.5)
    }, {
        New("UICorner", { CornerRadius = UDim.new(1, 0) })
    })
    ripple.Parent = button
    local maxSize = math.max(button.AbsoluteSize.X, button.AbsoluteSize.Y) * 2.5
    Tween(ripple, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, maxSize, 0, maxSize),
        BackgroundTransparency = 1
    }, function()
        ripple:Destroy()
    end)
end

-- ========== CONFIG SYSTEM ==========
function SuperLib:LoadConfig()
    local success, result = pcall(function()
        if writefile and readfile and isfile then
            if isfile(self._configPath) then
                return HttpService:JSONDecode(readfile(self._configPath))
            end
        end
        return {}
    end)
    if success then
        self._configCache = result or {}
    else
        self._configCache = {}
    end
    return self._configCache
end

function SuperLib:SaveConfig(data)
    self._configCache = data or self._configCache or {}
    pcall(function()
        if writefile then
            writefile(self._configPath, HttpService:JSONEncode(self._configCache))
        end
    end)
end

function SuperLib:GetConfigValue(key, default)
    if not self._configCache then
        self:LoadConfig()
    end
    local val = self._configCache[key]
    if val == nil then
        return default
    end
    return val
end

function SuperLib:SetConfigValue(key, value)
    if not self._configCache then
        self:LoadConfig()
    end
    self._configCache[key] = value
    self:SaveConfig()
end

