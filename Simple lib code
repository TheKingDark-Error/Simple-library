-- ========== THEME REGISTRY ==========
local ThemeRegistry = {}
local function RegisterThemeObject(obj, prop, themeKey)
    if obj and prop and themeKey then
        table.insert(ThemeRegistry, { Object = obj, Property = prop, ThemeKey = themeKey })
    end
end

local function ApplyTheme()
    local theme = SimpleLib.Themes[SimpleLib.Theme] or SimpleLib.Themes.Dark
    if not theme then return end
    for _, entry in ipairs(ThemeRegistry) do
        if entry.Object and entry.Object.Parent then
            pcall(function()
                entry.Object[entry.Property] = theme[entry.ThemeKey]
            end)
        end
    end
end

-- ========== UTILITY ==========
local function New(Class, Props, Children)
    local obj = Instance.new(Class)
    for k, v in pairs(Props or {}) do
        obj[k] = v
    end
    for _, child in ipairs(Children or {}) do
        child.Parent = obj
    end
    return obj
end

local function Tween(obj, props, duration, style, dir)
    duration = duration or 0.3
    style = style or Enum.EasingStyle.Quad
    dir = dir or Enum.EasingDirection.Out
    local tween = TweenService:Create(obj, TweenInfo.new(duration, style, dir), props)
    tween:Play()
    return tween
end

local function SpringTween(obj, props, duration)
    duration = duration or 0.5
    local tween = TweenService:Create(obj, TweenInfo.new(duration, Enum.EasingStyle.Back, Enum.EasingDirection.Out), props)
    tween:Play()
    return tween
end

local function GetTheme()
    return SimpleLib.Themes[SimpleLib.Theme] or SimpleLib.Themes.Dark
end

-- ========== CONFIG SYSTEM ==========
local ConfigFolder = "SimpleLibConfigs"
local function GetConfigPath(name)
    return ConfigFolder .. "/" .. name .. ".json"
end

function SimpleLib:CreateConfig(name, data)
    if not name then return false end
    local json = HttpService:JSONEncode(data or {})
    pcall(function()
        if not isfolder(ConfigFolder) then makefolder(ConfigFolder) end
        writefile(GetConfigPath(name), json)
    end)
    return true
end

function SimpleLib:LoadConfig(name)
    if not name then return nil end
    local success, result = pcall(function()
        return HttpService:JSONDecode(readfile(GetConfigPath(name)))
    end)
    if success then return result end
    return nil
end

function SimpleLib:DeleteConfig(name)
    if not name then return false end
    return pcall(function() delfile(GetConfigPath(name)) end)
end

function SimpleLib:OverwriteConfig(name, data)
    return self:CreateConfig(name, data)
end

function SimpleLib:ListConfigs()
    local list = {}
    pcall(function()
        if isfolder(ConfigFolder) then
            for _, file in ipairs(listfiles(ConfigFolder)) do
                local name = file:match("([^/\\]+)%.json$")
                if name then table.insert(list, name) end
            end
        end
    end)
    return list
end

function SimpleLib:SetAutoLoadConfig(name)
    self.AutoLoadConfig = name
end

function SimpleLib:GetAutoLoadConfig()
    return self.AutoLoadConfig
end

-- ========== NOTIFICATION SYSTEM (STACKED, ANIMATED, 200px) ==========
local NotifyStacks = {
    TopRight = {},
    TopLeft = {},
    BottomRight = {},
    BottomLeft = {},
}
local NotifyMaxStack = 5
local NotifySpacing = 8
local NotifyWidth = 200

local function GetStackPosition(position, index)
    local offset = (index - 1) * (70 + NotifySpacing)
    if position == "TopRight" then
        return UDim2.new(1, -NotifyWidth - 10, 0, 10 + offset)
    elseif position == "TopLeft" then
        return UDim2.new(0, 10, 0, 10 + offset)
    elseif position == "BottomRight" then
        return UDim2.new(1, -NotifyWidth - 10, 1, -70 - offset)
    else
        return UDim2.new(0, 10, 1, -70 - offset)
    end
end

local function RebuildStack(position)
    local stack = NotifyStacks[position]
    for i, notify in ipairs(stack) do
        if notify and notify.Frame and notify.Frame.Parent then
            local targetPos = GetStackPosition(position, i)
            Tween(notify.Frame, { Position = targetPos }, 0.3, Enum.EasingStyle.Quad)
        end
    end
end

