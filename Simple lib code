            isCollapsed = not isCollapsed
            TabContainer.Visible = not isCollapsed
            Header.Arrow.Text = isCollapsed and ">" or "v"
        end)

        local Section = {
            Container = TabContainer,
            Tab = function(_, tabConfig)
                local tabTitle = tabConfig.title or "Tab"
                local TabButton = New("TextButton", {
                    Size = UDim2.new(1, 0, 0, 32),
                    BackgroundColor3 = Color3.fromRGB(40, 40, 45),
                    AutoButtonColor = false,
                    Text = "",
                    BorderSizePixel = 0
                }, {
                    New("UICorner", { CornerRadius = UDim.new(0, 6) }),
                    New("TextLabel", {
                        Text = tabTitle,
                        TextColor3 = Color3.fromRGB(220, 220, 230),
                        Font = Enum.Font.GothamSemibold,
                        TextSize = 14,
                        BackgroundTransparency = 1,
                        Size = UDim2.new(1, 0, 1, 0),
                        TextXAlignment = Enum.TextXAlignment.Center
                    })
                })

                TabButton.MouseEnter:Connect(function()
                    TabButton.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
                end)
                TabButton.MouseLeave:Connect(function()
                    TabButton.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
                end)

                TabButton.Parent = TabContainer

                local TabContent = New("ScrollingFrame", {
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1,
                    ScrollBarThickness = 4,
                    CanvasSize = UDim2.new(0, 0, 0, 0),
                    AutomaticCanvasSize = Enum.AutomaticSize.Y,
                    Visible = #Window.Tabs == 0
                }, {
                    New("UIListLayout", {
                        SortOrder = Enum.SortOrder.LayoutOrder,
                        Padding = UDim.new(0, 10)
                    }),
                    New("UIPadding", {
                        PaddingTop = UDim.new(0, 6),
                        PaddingLeft = UDim.new(0, 6),
                        PaddingRight = UDim.new(0, 6),
                        PaddingBottom = UDim.new(0, 6)
                    })
                })

                TabContent.Parent = MainPanel

                TabButton.MouseButton1Click:Connect(function()
                    for _, t in ipairs(Window.Tabs) do
                        t.Content.Visible = false
                    end
                    TabContent.Visible = true
                end)

                local Tab = {
                    Content = TabContent
                }

                -- Copy methods from main Tab
                local dummyTab = Window:Tab({title = ""})
                for name, func in pairs(dummyTab) do
                    if type(func) == "function" then
                        Tab[name] = func
                    end
                end

                table.insert(Window.Tabs, Tab)
                return Tab
            end
        }

        return Section
    end

    return Window
end

return SuperLib
