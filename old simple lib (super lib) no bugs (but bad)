                BackgroundColor3 = Color3.fromRGB(50, 200, 100),
                BorderSizePixel = 0,
                ZIndex = 101,
                LayoutOrder = 3,
            }, { New("UICorner", { CornerRadius = UDim.new(0, 1.5) }) })
