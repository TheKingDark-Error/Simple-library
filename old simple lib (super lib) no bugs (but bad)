                        TextYAlignment = Enum.TextYAlignment.Center,
                        AutomaticSize = Enum.AutomaticSize.Y,
                        TextWrapped = true
                    })
                    SLabel.Parent = Tab.Content
                end

                function Tab:SLBig(config)
                    local content = config.content or "Simple Label Big"
                    local SLabelBig = New("TextLabel", {
                        Size = UDim2.new(1, 0, 0, 0),
                        BackgroundTransparency = 1,
                        Text = content,
                        TextSize = 18,
                        Font = Enum.Font.GothamBold,
                        TextColor3 = Color3.fromRGB(255, 255, 255),
                        TextXAlignment = Enum.TextXAlignment.Left,
                        TextYAlignment = Enum.TextYAlignment.Center,
                        AutomaticSize = Enum.AutomaticSize.Y,
                        TextWrapped = true
                    })
                    SLabelBig.Parent = Tab.Content
                end

                function Tab:Label(config)
                    local labelTitle = config.title or "Label"
                    local labelDesc = config.desc or ""

                    local LabelFrame = New("Frame", {
                        Size = UDim2.new(1, 0, 0, 0),
                        BackgroundColor3 = Color3.fromRGB(28, 28, 32),
                        BorderSizePixel = 0,
                        AutomaticSize = Enum.AutomaticSize.Y
                    }, {
                        New("UICorner", { CornerRadius = UDim.new(0, 6) }),
                        New("UIPadding", {
                            PaddingTop = UDim.new(0, 8),
                            PaddingLeft = UDim.new(0, 12),
                            PaddingRight = UDim.new(0, 12),
                            PaddingBottom = UDim.new(0, 8)
                        }),
                        New("UIListLayout", {
                            SortOrder = Enum.SortOrder.LayoutOrder,
                            Padding = UDim.new(0, 4)
                        })
                    })

                    local Title = New("TextLabel", {
                        Text = labelTitle,
                        TextColor3 = Color3.fromRGB(255, 255, 255),
                        Font = Enum.Font.GothamBold,
                        TextSize = 18,
                        BackgroundTransparency = 1,
                        Size = UDim2.new(1, 0, 0, 0),
                        AutomaticSize = Enum.AutomaticSize.Y,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        TextWrapped = true,
                        TextScaled = false
                    })
                    Title.Parent = LabelFrame

                    local Desc = New("TextLabel", {
                        Text = labelDesc,
                        TextColor3 = Color3.fromRGB(180, 180, 190),
                        Font = Enum.Font.Gotham,
                        TextSize = 12,
                        BackgroundTransparency = 1,
                        Size = UDim2.new(1, 0, 0, 0),
                        AutomaticSize = Enum.AutomaticSize.Y,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        Visible = labelDesc ~= "",
                        TextWrapped = true,
                        TextScaled = false
                    })
                    Desc.Parent = LabelFrame

                    LabelFrame.Parent = Tab.Content

                    local LabelObj = {
                        ElementFrame = LabelFrame,
                        _titleLabel = Title,
                        _descLabel = Desc,
                    }
                    local LabelMeta = {
                        __index = function(self, key)
                            if key == "title" then
                                return self._titleLabel.Text
                            elseif key == "desc" then
                                return self._descLabel.Text
                            end
                            return rawget(self, key)
                        end,
                        __newindex = function(self, key, value)
                            if key == "title" then
                                self._titleLabel.Text = value
                            elseif key == "desc" then
                                self._descLabel.Text = value
                                self._descLabel.Visible = value ~= ""
                            else
                                rawset(self, key, value)
                            end
                        end
                    }
                    setmetatable(LabelObj, LabelMeta)
                    return LabelObj
                end

                function Tab:Slider(sliderConfig)
                    local title = sliderConfig.title or "Slider"
                    local desc = sliderConfig.desc or ""
                    local min = sliderConfig.min or 0
                    local max = sliderConfig.max or 100
                    local default = sliderConfig.default or min
                    local callback = sliderConfig[1] or function() end
                    local minVal = tonumber(min) or 0
                    local maxVal = tonumber(max) or 0
                    if maxVal < minVal then maxVal = minVal end
                    local CurrentValue = math.clamp(default, minVal, maxVal)

                    local SliderFrame = New("Frame", {
                        Size = UDim2.new(1, 0, 0, 52),
                        BackgroundColor3 = Color3.fromRGB(28, 28, 32),
                        BorderSizePixel = 0
                    }, {
                        New("UICorner", { CornerRadius = UDim.new(0, 6) }),
                        New("TextLabel", {
                            Name = "Title",
                            Text = title,
                            TextColor3 = Color3.fromRGB(255, 255, 255),
                            Font = Enum.Font.GothamBold,
                            TextSize = 15,
                            BackgroundTransparency = 1,
                            Position = UDim2.new(0, 12, 0, 4),
                            Size = UDim2.new(1, -24, 0, 16)
                        }),
                        New("TextLabel", {
                            Name = "Desc",
                            Text = desc,
                            TextColor3 = Color3.fromRGB(180, 180, 190),
                            Font = Enum.Font.Gotham,
                            TextSize = 12,
                            BackgroundTransparency = 1,
                            Position = UDim2.new(0, 12, 0, 20),
                            Size = UDim2.new(1, -24, 0, 14)
                        }),
                        New("TextLabel", {
                            Name = "ValueLabel",
                            Text = tostring(CurrentValue),
                            TextColor3 = Color3.fromRGB(220, 220, 230),
                            Font = Enum.Font.GothamSemibold,
                            TextSize = 14,
                            BackgroundTransparency = 1,
                            Position = UDim2.new(1, -40, 0, 36),
                            Size = UDim2.new(0, 40, 0, 14),
                            TextXAlignment = Enum.TextXAlignment.Right
                        }),
                        New("Frame", {
                            Name = "Track",
                            Size = UDim2.new(1, -24, 0, 4),
                            Position = UDim2.new(0, 12, 0, 36),
                            BackgroundColor3 = Color3.fromRGB(60, 60, 70),
                            BorderSizePixel = 0
                        }, {
                            New("UICorner", { CornerRadius = UDim.new(1, 0) }),
                            New("Frame", {
                                Name = "Fill",
                                Size = UDim2.new((CurrentValue - minVal) / (math.max(1, (maxVal - minVal))), 0, 1, 0),
                                BackgroundColor3 = Color3.fromRGB(50, 200, 100),
                                BorderSizePixel = 0,
                                Active = false
                            }, {
                                New("UICorner", { CornerRadius = UDim.new(1, 0) })
                            }),
                            New("Frame", {
                                Name = "Thumb",
                                Size = UDim2.new(0, 16, 0, 16),
                                Position = UDim2.new((CurrentValue - minVal) / (math.max(1, (maxVal - minVal))), -8, 0.5, -8),
                                BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                                BorderSizePixel = 0,
                                Active = false
                            }, {
                                New("UICorner", { CornerRadius = UDim.new(1, 0) })
                            })
                        })
                    })

                    local Track = SliderFrame.Track
                    local Fill = Track.Fill
                    local Thumb = Track.Thumb
                    local ValueLabel = SliderFrame.ValueLabel
                    local dragging = false

                    local function UpdateSlider(mouseX)
                        local trackX = Track.AbsolutePosition.X
                        local trackWidth = Track.AbsoluteSize.X
                        local relX = math.clamp(mouseX - trackX, 0, trackWidth)
                        local denom = math.max(1, (maxVal - minVal))
                        CurrentValue = math.floor(minVal + denom * (relX / trackWidth) + 0.5)
                        ValueLabel.Text = tostring(CurrentValue)
                        local fillRatio = (CurrentValue - minVal) / denom
                        Fill.Size = UDim2.new(fillRatio, 0, 1, 0)
                        Thumb.Position = UDim2.new(fillRatio, -8, 0.5, -8)
                    end

                    Track.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                            dragging = true
                            UpdateSlider(input.Position.X)
                        end
                    end)

                    UserInputService.InputChanged:Connect(function(input)
                        if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) and dragging then
                            UpdateSlider(input.Position.X)
                        end
                    end)

                    UserInputService.InputEnded:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                            if dragging then
                                dragging = false
                                callback(CurrentValue)
                            end
                        end
                    end)

                    SliderFrame.Parent = Tab.Content
                end

                table.insert(Window.Tabs, Tab)
                return Tab
            end
        }

        return Section
    end

    return Window
end

return SuperLib