            ZIndex = 1000
        }, {
            New("UICorner", { CornerRadius = UDim.new(0, 6) })
        })

        local libLabel = New("TextLabel", {
            Text = libName,
            Font = Enum.Font.GothamBold,
            TextSize = 22,
            TextColor3 = Color3.fromRGB(50, 220, 120),
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 12, 0, 8),
            Size = UDim2.new(1, -24, 0, 30),
            TextXAlignment = Enum.TextXAlignment.Left
        })

        local subLabel = New("TextLabel", {
            Text = subTitle,
            Font = Enum.Font.Gotham,
            TextSize = 12,
            TextColor3 = Color3.fromRGB(150, 255, 180),
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 12, 0, 36),
            Size = UDim2.new(1, -24, 0, 18),
            TextXAlignment = Enum.TextXAlignment.Left
        })

        local barBg = New("Frame", {
            Size = UDim2.new(1, -24, 0, 12),
            Position = UDim2.new(0, 12, 1, -28),
            AnchorPoint = Vector2.new(0, 0),
            BackgroundColor3 = Color3.fromRGB(20, 20, 20),
            BorderSizePixel = 0
        }, {
            New("UICorner", { CornerRadius = UDim.new(0, 6) })
        })

        local barFill = New("Frame", {
            Size = UDim2.new(0, 0, 1, 0),
            Position = UDim2.new(0, 0, 0, 0),
            BackgroundColor3 = Color3.fromRGB(50, 220, 120),
            BorderSizePixel = 0,
            ZIndex = 1001
        }, {
            New("UICorner", { CornerRadius = UDim.new(0, 6) })
        })

        local percentLabel = New("TextLabel", {
            Text = "0%",
            Font = Enum.Font.Gotham,
            TextSize = 12,
            TextColor3 = Color3.fromRGB(200, 255, 200),
            BackgroundTransparency = 1,
            Position = UDim2.new(1, -60, 1, -48),
            Size = UDim2.new(0, 48, 0, 18),
            ZIndex = 1002,
            TextXAlignment = Enum.TextXAlignment.Right
        })

        barFill.Parent = barBg
        center.Parent = loading
        libLabel.Parent = center
        subLabel.Parent = center
        barBg.Parent = center
        percentLabel.Parent = center
        loading.Parent = MainFrame

        local tween = TweenService:Create(barFill, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Size = UDim2.new(1, 0, 1, 0) })
        tween:Play()

        local start = tick()
        task.spawn(function()
            while tick() - start < duration do
                local t = (tick() - start) / duration
                local pct = math.clamp(math.floor(t * 100), 0, 100)
                percentLabel.Text = tostring(pct) .. "%"
                if math.random() < 0.05 then
                    subLabel.Text = subTitle .. string.rep(".", math.random(0, 3))
                else
                    subLabel.Text = subTitle
                end
                task.wait(0.04)
            end
            percentLabel.Text = "100%"
        end)

        tween.Completed:Wait()

        local fade = TweenService:Create(loading, TweenInfo.new(0.25, Enum.EasingStyle.Quad), { BackgroundTransparency = 1 })
        local moveUp = TweenService:Create(center, TweenInfo.new(0.25, Enum.EasingStyle.Quad), { Position = UDim2.new(0.5, 0, 0.45, 0) })
        fade:Play()
        moveUp:Play()
        moveUp.Completed:Wait()
        loading:Destroy()
    end

