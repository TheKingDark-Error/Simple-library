            New("UIStroke", { Color = Color3.fromRGB(40, 180, 80), Thickness = 1 })
        })

        local center = New("Frame", {
            Size = UDim2.new(0, 360, 0, 120),
            Position = UDim2.new(0.5, 0, 0.5, 0),
            AnchorPoint = Vector2.new(0.5, 0.5),
